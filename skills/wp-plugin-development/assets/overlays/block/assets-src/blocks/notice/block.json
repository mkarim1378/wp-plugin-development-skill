{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "{{slug}}/notice",
	"version": "{{version}}",
	"title": "Notice",
	"category": "widgets",
	"icon": "info",
	"description": "A highlighted notice rendered on the server.",
	"textdomain": "{{slug}}",
	"attributes": {
		"message": {
			"type": "string",
			"default": "",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
