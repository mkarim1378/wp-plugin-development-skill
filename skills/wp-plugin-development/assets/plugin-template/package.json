{
	"name": "{{slug}}",
	"version": "{{version}}",
	"private": true,
	"description": "{{description}}",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/{{slug}} vendor/bin/phpunit",
		"i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/{{slug}} wp i18n make-pot . languages/{{slug}}.pot --exclude=node_modules,vendor,tests",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"{{slug}}.php",
		"uninstall.php",
		"readme.txt",
		"src",
		"vendor",
		"languages"
	],
	"devDependencies": {
		"@wordpress/env": "^10.0.0",
		"@wordpress/scripts": "^30.0.0"
	}
}
